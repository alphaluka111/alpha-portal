generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
enum Role { ADMIN TEACHER STUDENT PARENT }
model User { id String @id @default(cuid()) firstName String lastName String email String @unique password String? role Role avatarUrl String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt taughtClasses Class[] @relation("TeacherClasses") studentClasses Enrollment[] grades Grade[] attendance Attendance[] parentLinks ParentStudent[] @relation("ParentLinks") childLinks ParentStudent[] @relation("ChildLinks") }
model Class { id String @id @default(cuid()) name String year Int teacherId String? teacher User? @relation("TeacherClasses", fields:[teacherId], references:[id]) enrollments Enrollment[] grades Grade[] attendance Attendance[] createdAt DateTime @default(now()) }
model Subject { id String @id @default(cuid()) name String code String @unique grades Grade[] createdAt DateTime @default(now()) }
model Enrollment { id String @id @default(cuid()) studentId String classId String student User @relation(fields:[studentId], references:[id], onDelete:Cascade) class Class @relation(fields:[classId], references:[id], onDelete:Cascade) @@unique([studentId,classId]) }
model Grade { id String @id @default(cuid()) value Float assessment String? studentId String subjectId String classId String? student User @relation(fields:[studentId], references:[id], onDelete:Cascade) subject Subject @relation(fields:[subjectId], references:[id]) class Class? @relation(fields:[classId], references:[id]) createdAt DateTime @default(now()) }
model Attendance { id String @id @default(cuid()) date DateTime status String studentId String classId String student User @relation(fields:[studentId], references:[id], onDelete:Cascade) class Class @relation(fields:[classId], references:[id]) @@unique([date,studentId,classId]) }
model ParentStudent { parentId String studentId String parent User @relation("ParentLinks", fields:[parentId], references:[id], onDelete:Cascade) student User @relation("ChildLinks", fields:[studentId], references:[id], onDelete:Cascade) @@id([parentId,studentId]) }
